    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/env": "16.4.2",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9",
    "vitest": "5.1.0"
  }
