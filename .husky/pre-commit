# Guard: main only changes through reviewed PRs (mirrors GitHub branch protection).
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "Blocked: direct commits to main are not allowed. Use a feature branch + PR." >&2
  exit 1
fi
# Fall back to corepack when pnpm is not on PATH.
command -v pnpm >/dev/null 2>&1 || pnpm() { corepack pnpm "$@"; }
pnpm exec lint-staged
