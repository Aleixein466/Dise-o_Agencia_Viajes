# Guard: never push to main directly; run checks before any push.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Blocked: pushes to main are not allowed. Open a PR instead." >&2
    exit 1
  fi
done
# Fall back to corepack when pnpm is not on PATH.
command -v pnpm >/dev/null 2>&1 || pnpm() { corepack pnpm "$@"; }
pnpm lint && pnpm typecheck && pnpm test
