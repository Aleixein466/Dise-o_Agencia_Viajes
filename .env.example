# Copy to .env and replace every placeholder. Never commit .env.
# Environment validation and defaults are defined in src/lib/env.ts.
# Local-only database credentials (used by docker-compose.yml). Generate a unique password.
POSTGRES_USER="ricaurte"
POSTGRES_PASSWORD="REPLACE_WITH_LOCAL_DEV_PASSWORD"
POSTGRES_DB="ricaurte_tours"
DATABASE_URL="postgresql://ricaurte:REPLACE_WITH_LOCAL_DEV_PASSWORD@127.0.0.1:5432/ricaurte_tours?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Safety flags: keep "false" until PC-6 (approved privacy policy) and security gates pass.
QUOTE_INTAKE_ENABLED="false"
PRIVACY_POLICY_APPROVED="false"
