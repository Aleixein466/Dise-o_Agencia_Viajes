# Copy to .env and replace every placeholder. Never commit .env.
# Environment validation and defaults: apps/web/src/lib/env.ts and apps/api/src/config/env.ts.
# Local-only database credentials (used by docker-compose.yml). Generate a unique password.
POSTGRES_USER="ricaurte"
POSTGRES_PASSWORD="REPLACE_WITH_LOCAL_DEV_PASSWORD"
POSTGRES_DB="ricaurte_tours"
DATABASE_URL="postgresql://ricaurte:REPLACE_WITH_LOCAL_DEV_PASSWORD@127.0.0.1:5432/ricaurte_tours?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# apps/api (NestJS). Web proxies /api/v1/* to API_INTERNAL_URL (read at build time); leave unset to disable the proxy.
API_INTERNAL_URL="http://127.0.0.1:4000"
APP_ORIGIN="http://localhost:3000"
# Required before a staff member can provision TOTP. Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
# Never commit values. Only for the manual, non-production `pnpm --filter @ricaurte/api auth:bootstrap` procedure.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
# Safety flags: keep "false" until PC-6 (approved privacy policy) and security gates pass.
QUOTE_INTAKE_ENABLED="false"
PRIVACY_POLICY_APPROVED="false"
# Keep "false" outside the authorised production deployment (staging must never be indexed).
SITE_INDEXING="false"
# Client IP source for rate limiting. "none" until a trusted proxy overwrites the header.
CLIENT_IP_SOURCE="none"
TRUSTED_PROXY_HOPS="1"

# Distributed limiter: keep "memory" outside production. Production intake is refused until a shared store exists.
RATE_LIMIT_STORE="memory"
