# Staging environment for deploy/staging/docker-compose.staging.yml. Copy to .env.staging (git-ignored) and fill in.
# Generate secrets on the staging host, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse production or personal credentials. Never commit the filled file.

POSTGRES_USER=ricaurte_staging
POSTGRES_PASSWORD=
POSTGRES_DB=ricaurte_staging

# Public HTTPS origin of the staging web app (Vercel branch "staging" with protection enabled).
APP_ORIGIN=https://staging.example.invalid
WEB_ORIGIN=https://staging.example.invalid
# Reverse proxies between the client and the API (1 behind a single TLS proxy).
TRUST_PROXY_HOPS=1
API_PORT=4000

# 32 random bytes, base64. Rotating MFA_ENCRYPTION_KEY invalidates enrolled authenticators.
MFA_ENCRYPTION_KEY=
CUSTOMER_CODE_SECRET=

# Intake stays closed until the agency approves its legal texts (see docs/operations/GO_LIVE_CHECKLIST.md).
PUBLIC_QUOTE_REQUESTS_ENABLED=false
PQRS_INTAKE_ENABLED=false
PQRS_HOLIDAYS=colombia

# No real charges: payments disabled until Wompi SANDBOX keys exist (docs/operations/WOMPI_SANDBOX.md).
# "wompi_sandbox" requires the four test keys below (pub_test_/prv_test_/test_events_/test_integrity_);
# the API refuses to start with any production key (pub_prod_/prv_prod_/prod_). Never commit real values.
PAYMENT_ADAPTER=disabled
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# No real mail: "disabled" (or "smtp" to a sandbox inbox such as a Mailpit/Mailtrap instance, never a real
# provider without MAIL_REAL_DELIVERY_APPROVED=true and written authorization).
MAIL_ADAPTER=disabled
SMTP_URL=
MAIL_FROM=
MAIL_REAL_DELIVERY_APPROVED=false
NOTIFICATIONS_DISPATCH_INTERVAL_MS=0

# One-off admin bootstrap (docker compose ... run --rm bootstrap). Clear these values afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador staging
