  @@map("payment_plans")
}

/// Legacy. See PaymentPlan.
model Installment {
  id String @id @default(uuid()) @db.Uuid
  paymentPlanId String @db.Uuid @map("payment_plan_id")
  dueAt DateTime @map("due_at")
  amount Decimal @db.Decimal(14, 2)
  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  @@index([paymentPlanId, dueAt])
  @@map("installments")
}

/// Abonos / ahorro programado administered by the agency (§11.4). Balance comes from LedgerEntry.
model SavingsPlan {
  id String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid @map("customer_id")
  /// Legacy decimal goal. Use goalCents.
  goalAmount Decimal? @db.Decimal(14, 2) @map("goal_amount")
  goalCents BigInt? @map("goal_cents")
  currency String @default("COP") @db.VarChar(3)
  status PaymentPlanStatus @default(ACTIVE)
  name String? @db.VarChar(160)
  reservationId String? @db.Uuid @map("reservation_id")
  packageId String? @db.Uuid @map("package_id")
  targetDate DateTime? @db.Date @map("target_date")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  customer Customer @relation(fields: [customerId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  package TourPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  movements SavingsMovement[]
  installments SavingsPlanInstallment[]
  payments Payment[]
  ledgerEntries LedgerEntry[]
  manualAbonos ManualAbono[]
  @@index([customerId])
  @@index([reservationId])
  @@map("savings_plans")
}

model SavingsPlanInstallment {
  id String @id @default(uuid()) @db.Uuid
  savingsPlanId String @db.Uuid @map("savings_plan_id")
  sequence Int
  dueOn DateTime @db.Date @map("due_on")
  amountCents BigInt @map("amount_cents")
  createdAt DateTime @default(now()) @map("created_at")
  savingsPlan SavingsPlan @relation(fields: [savingsPlanId], references: [id], onDelete: Cascade)
  @@unique([savingsPlanId, sequence])
  @@index([dueOn])
  @@map("savings_plan_installments")
}

/// Legacy decimal movements. v2 money lives in LedgerEntry.
model SavingsMovement {
  id String @id @default(uuid()) @db.Uuid
  savingsPlanId String @db.Uuid @map("savings_plan_id")
  amount Decimal @db.Decimal(14, 2)
  externalReference String? @unique @map("external_reference")
  createdAt DateTime @default(now()) @map("created_at")
