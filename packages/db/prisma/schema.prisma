// ---------------------------------------------------------------------------
// Compliance: legal, consent, PQR, audit, settings
// ---------------------------------------------------------------------------

/// Versioned legal text. Only APPROVED versions may be shown or accepted (PC-6).
model LegalDocument {
  id String @id @default(uuid()) @db.Uuid
  type LegalDocumentType
  version String @db.VarChar(40)
  title String @db.VarChar(200)
  body String @db.Text
  contentSha256 String @db.Char(64) @map("content_sha256")
  status LegalDocumentStatus @default(DRAFT)
  approvedAt DateTime? @map("approved_at")
  approvedById String? @db.Uuid @map("approved_by_id")
  effectiveFrom DateTime? @map("effective_from")
  supersededAt DateTime? @map("superseded_at")
  createdAt DateTime @default(now()) @map("created_at")
  approvedBy User? @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  consentRecords ConsentRecord[]
  @@unique([type, version])
  @@index([type, status])
  @@map("legal_documents")
}

/// Append-only (DB trigger). Withdrawal is a new row with granted = false.
model ConsentRecord {
  id String @id @default(uuid()) @db.Uuid
  purpose ConsentPurpose
  legalDocumentId String @db.Uuid @map("legal_document_id")
  /// Denormalised copy of the accepted LegalDocument.version.
  legalDocumentVersion String @db.VarChar(40) @map("legal_document_version")
  granted Boolean
  userId String? @db.Uuid @map("user_id")
  customerId String? @db.Uuid @map("customer_id")
  /// Lowercased; for anonymous forms.
  email String? @db.VarChar(254)
  quoteId String? @db.Uuid @map("quote_id")
  reservationId String? @db.Uuid @map("reservation_id")
  /// Form or flow that collected the consent, e.g. "quote_form".
  source String @db.VarChar(80)
  ipHash String? @db.Char(64) @map("ip_hash")
  userAgentHash String? @db.Char(64) @map("user_agent_hash")
  at DateTime @default(now())
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  @@index([customerId, purpose, at])
  @@index([userId, purpose, at])
  @@index([email, purpose, at])
  @@index([reservationId])
  @@map("consent_records")
}

/// PQR ticket. customerId is optional in v2 so anyone can file one (requester* fields).
model PqrsTicket {
  id String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(24)
  customerId String? @db.Uuid @map("customer_id")
  bookingId String? @db.Uuid @map("booking_id")
  reservationId String? @db.Uuid @map("reservation_id")
  type PqrsType
  status PqrsStatus @default(RECEIVED)
  subject String @db.VarChar(160)
  description String @db.Text
  /// PII.
  requesterName String? @db.VarChar(120) @map("requester_name")
  /// PII. Lowercased.
  requesterEmail String? @db.VarChar(254) @map("requester_email")
  /// PII.
  requesterPhone String? @db.VarChar(25) @map("requester_phone")
  assignedToId String? @db.Uuid @map("assigned_to_id")
  /// SLA dates computed by the application from the agency's PQR policy.
  firstResponseDueAt DateTime? @map("first_response_due_at")
  resolutionDueAt DateTime? @map("resolution_due_at")
  firstRespondedAt DateTime? @map("first_responded_at")
  resolvedAt DateTime? @map("resolved_at")
  closedAt DateTime? @map("closed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  assignedTo User? @relation("pqrs_assignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages PqrsMessage[]
  crmNotes CrmNote[]
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([assignedToId, status])
  @@index([resolutionDueAt])
  @@map("pqrs_tickets")
}

model PqrsMessage {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid @map("ticket_id")
  message String @db.Text
  isStaff Boolean @default(false) @map("is_staff")
  /// Internal staff note, never shown to the requester.
  isInternal Boolean @default(false) @map("is_internal")
  authorId String? @db.Uuid @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  ticket PqrsTicket @relation(fields: [ticketId], references: [id])
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  @@index([ticketId, createdAt])
  @@map("pqrs_messages")
}

