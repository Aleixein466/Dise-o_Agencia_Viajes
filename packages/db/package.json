    "@prisma/client": "7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "dotenv": "17.4.2",
    "prisma": "7.10.1",
    "typescript": "^5.9"
  }
}
